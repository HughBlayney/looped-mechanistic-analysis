#!/usr/bin/env bash
#SBATCH --job-name=isolating_stability
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --qos=medium
#SBATCH --time=24:00:00
#SBATCH --partition=normal
#SBATCH --output=slurm_out/slurm-%x-%j.out

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:?Submit from the repository root}"
bash slurm_jobs/run_notebook.sh isolating_stability "$@"
