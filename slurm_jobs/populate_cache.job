#!/usr/bin/env bash
#SBATCH --job-name=populate_cache
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --qos=medium
#SBATCH --time=24:00:00
#SBATCH --partition=normal
#SBATCH --output=slurm_out/slurm-%x-%j.out

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:?Submit from the repository root}"
export MPLBACKEND=Agg
export MPLCONFIGDIR="${TMPDIR:-/tmp}/looped-matplotlib-${SLURM_JOB_ID:-local}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export TOKENIZERS_PARALLELISM=false
# The runner plans matching convergence/stages requests before collection so
# their required curves and profiles can share one forward pass.
.venv/bin/python -m experiments.run_cached --collect-only "$@"
